# PostgreSQL connection string. Neon example:
# postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/employboard?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/employboard

# Required for POST /api/admin/sync and GET /api/admin/sync/runs.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET=

# Comma-separated list of allowed frontend origins. Use * only if you accept
# that any website can call the public read-only API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENVIRONMENT=development
LOG_LEVEL=INFO

# In-process scheduler. Disable when using the Render cron job / external cron.
ENABLE_SCHEDULER=true
SYNC_INTERVAL_HOURS=6

# Seed the verified company registry when the API starts (also available as
# `python -m app.cli seed`).
SEED_ON_STARTUP=false

# Polite HTTP defaults for public ATS APIs.
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
USER_AGENT=EmployBoard/1.0 (public job aggregation; contact: admin@employboard.example)

# SmartRecruiters list responses do not include descriptions. The ingestion
# worker enriches a bounded number of postings per sync, prioritising the
# newest jobs that still have no description.
SMARTRECRUITERS_DETAIL_LIMIT=100

# A listing is deactivated only after this many consecutive successful syncs
# confirm it is absent (and only when the fetch count is healthy).
DEACTIVATION_MISS_THRESHOLD=2
